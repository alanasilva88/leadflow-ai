generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SalesPotential {
  HIGH
  MEDIUM
  LOW
}

enum LeadStatus {
  NEW
  ANALYZED
  CONTACTED
  RESPONDED
  FOLLOW_UP
  MEETING
  PROPOSAL
  CLOSED
  LOST
}

enum LeadResponse {
  NO_RESPONSE
  POSITIVE
  NEGATIVE
  MORE_INFORMATION
  CONTACT_LATER
  MEETING_SCHEDULED
  PROPOSAL_SENT
  DEAL_CLOSED
}

enum AIAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AIConfidence {
  HIGH
  MEDIUM
  LOW
}

enum RecommendedService {
  LANDING_PAGE
  INSTITUTIONAL_SITE
  CHATBOT
  SCHEDULING_SYSTEM
  CUSTOM_SYSTEM
  DIGITAL_PRESENCE_REVIEW
}

enum LeadSource {
  MANUAL
  SPREADSHEET
  GOOGLE_PLACES
}

model Lead {
  id                  String         @id @default(cuid())
  businessName        String
  source              LeadSource     @default(MANUAL)
  externalPlaceId     String?        @unique
  niche               String?
  state               String?
  formattedAddress    String?
  googleMapsUrl       String?
  businessStatus      String?
  opportunityScore    Int            @default(0)
  phone               String?
  instagram           String?
  website             String?
  rating              Float?
  reviewCount         Int?
  segment             String?
  city                String?
  salesPotential      SalesPotential @default(MEDIUM)
  websiteStatus       String?
  websiteScore        Int?
  mainProblem         String?
  suggestedSolution   String?
  personalizedMessage String?
  status              LeadStatus     @default(NEW)
  contactedAt         DateTime?
  followUpDate        DateTime?
  response            LeadResponse?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  analyses            LeadAnalysis[]

  @@index([businessName])
  @@index([status])
  @@index([salesPotential])
  @@index([followUpDate])
  @@index([source])
  @@index([opportunityScore])
}

model LeadAnalysis {
  id                 String              @id @default(cuid())
  leadId             String
  lead               Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status             AIAnalysisStatus    @default(PENDING)
  salesPotential     SalesPotential?
  websiteScore       Int?
  mainOpportunity    String?
  evidence           Json?
  suggestedSolution  String?
  recommendedService RecommendedService?
  approachMessage    String?
  followUpMessage    String?
  confidence         AIConfidence?
  model              String?
  sourceWebsite      String?
  websiteCheckedAt   DateTime?
  analyzedAt         DateTime?
  errorMessage       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([leadId])
  @@index([status])
  @@index([analyzedAt])
}
